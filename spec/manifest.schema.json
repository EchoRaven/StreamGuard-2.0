{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamguard2/spec/manifest.schema.json",
  "title": "SG2 ClipRecord",
  "type": "object",
  "required": [
    "id",
    "source",
    "media",
    "label",
    "axes",
    "metadata_adversarial",
    "splice",
    "split",
    "pool"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "native",
            "synthetic"
          ]
        },
        "provenance": {
          "type": "string",
          "description": "切分按此分组,防同源泄漏"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "codec"
      ],
      "additionalProperties": true,
      "properties": {
        "duration_s": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "$comment": "未探测时用 null,**不要填 0** —— 0 是在假装知道一个不知道的值,下游按时长归一化时会除零"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "codec": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reencode": {
          "type": "object"
        }
      }
    },
    "label": {
      "type": "object",
      "required": [
        "safe",
        "categories",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "safe": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "safe": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "events": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "safe": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "events": {}
            },
            "$comment": "仅当 granularity=temporal 时强制;video_level 的数据没有 ν,由 ClipRecord 的 __post_init__ 按 granularity 区分"
          }
        }
      ]
    },
    "axes": {
      "type": "object",
      "required": [
        "temporal_sparsity",
        "perceptual_subtlety",
        "modality_locus",
        "context_dependence"
      ],
      "additionalProperties": false,
      "properties": {
        "temporal_sparsity": {
          "type": "object",
          "required": [
            "ratio",
            "bin"
          ],
          "properties": {
            "needle_total_s": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "video_duration_s": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bin": {
              "enum": [
                "dense",
                "sparse",
                "ultra_sparse"
              ]
            }
          }
        },
        "perceptual_subtlety": {
          "type": "object",
          "required": [
            "min_evidence_pixel_area_frac",
            "bin"
          ],
          "properties": {
            "min_evidence_pixel_area_frac": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_contrast": {
              "type": "number"
            },
            "evidence_span_frames": {
              "type": "integer",
              "minimum": 0
            },
            "requires_ocr": {
              "type": "boolean"
            },
            "bin": {
              "enum": [
                "salient",
                "moderate",
                "subtle"
              ]
            }
          }
        },
        "modality_locus": {
          "type": "object",
          "required": [
            "decisive",
            "bin"
          ],
          "properties": {
            "decisive": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/modality"
              },
              "minItems": 1
            },
            "pixel_only_sufficient": {
              "type": "boolean"
            },
            "bin": {
              "enum": [
                "visual",
                "speech",
                "text",
                "composition",
                "multi"
              ]
            }
          }
        },
        "context_dependence": {
          "type": "object",
          "required": [
            "window_required_s",
            "bin"
          ],
          "properties": {
            "frame_alone_sufficient": {
              "type": "boolean"
            },
            "window_required_s": {
              "type": "number",
              "minimum": 0
            },
            "bin": {
              "enum": [
                "self_contained",
                "short_context",
                "long_context"
              ]
            }
          }
        }
      }
    },
    "metadata_adversarial": {
      "type": "object",
      "required": [
        "condition"
      ],
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "asr_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "chat_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "enum": [
            "aligned",
            "fp_bait",
            "camouflage"
          ],
          "$comment": "fp_bait 必须 safe=true;camouflage 必须 safe=false"
        }
      }
    },
    "splice": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "host_id",
            "n_cuts",
            "cuts",
            "reencoded_uniformly"
          ],
          "additionalProperties": true,
          "properties": {
            "host_id": {
              "type": "string"
            },
            "n_cuts": {
              "type": "integer",
              "minimum": 0
            },
            "cuts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "t_s",
                  "kind"
                ],
                "properties": {
                  "t_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "kind": {
                    "enum": [
                      "benign",
                      "needle"
                    ]
                  },
                  "insert_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "audio_crossfade_ms": {
              "type": "integer",
              "minimum": 0
            },
            "loudness_lufs": {
              "type": "number"
            },
            "reencoded_uniformly": {
              "const": true,
              "$comment": "必须为 true。压缩域 sentinel 读编码器指纹,不统一即捷径"
            }
          }
        }
      ]
    },
    "split": {
      "enum": [
        "train",
        "calib",
        "test",
        "zeroday_holdout"
      ]
    },
    "pool": {
      "enum": [
        "exemplar",
        "compile",
        "calibration",
        "eval"
      ]
    },
    "granularity": {
      "enum": [
        "temporal",
        "video_level"
      ],
      "default": "temporal",
      "$comment": "video_level 表示只有视频级标注、拿不到 ν(如 SafeWatch-Bench),该记录会被排除出检测延迟统计"
    }
  },
  "$defs": {
    "modality": {
      "enum": [
        "pixel",
        "speech",
        "ocr",
        "motion",
        "composition"
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "category",
        "t_start_s",
        "t_end_s",
        "severity",
        "evidence_modality"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "t_start_s": {
          "type": "number",
          "minimum": 0,
          "$comment": "这就是 QCD 里的 ν"
        },
        "t_end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence_modality": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modality"
          },
          "minItems": 1
        },
        "sufficient_alone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modality"
          }
        },
        "bbox_track": {
          "type": [
            "array",
            "null"
          ]
        },
        "annotator_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agreement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}